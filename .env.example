# Copy to .env and replace every placeholder before starting Compose.
RESEARCH_ROOT=/absolute/path/to/research-repositories
AUTH_TOKENS_JSON='{"replace-with-secret-token":"workspace-member-id"}'
OPERATOR_ACTORS_JSON='["operations-user-id"]'

# Refresh every six hours, back up daily, and retry notifications every minute.
REFRESH_INTERVAL_MS=21600000
BACKUP_INTERVAL_MS=86400000
NOTIFICATION_INTERVAL_MS=60000
WORKER_STATUS_MAX_AGE_MS=86400000

# Leave operator delivery disabled until a real HTTPS destination is configured.
OPERATOR_NOTIFICATION_DELIVERY_MODE=disabled
OPERATOR_NOTIFICATION_WEBHOOK_URL=
OPERATOR_NOTIFICATION_ROUTES_JSON='{}'
