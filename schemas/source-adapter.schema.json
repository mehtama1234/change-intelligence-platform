{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://change-intelligence-platform.local/schemas/source-adapter.schema.json",
  "title": "Repository source adapter record",
  "type": "object",
  "required": ["id", "sourceRole", "sourceRepository", "sourcePath", "title", "observation", "mechanism", "affectedGroups", "claimState", "asOf", "limits"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "sourceRole": { "type": "string", "minLength": 1 },
    "sourceRepository": { "type": "string", "minLength": 1 },
    "sourcePath": { "type": "string", "minLength": 1 },
    "sourceLocator": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "observation": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "mechanism": { "type": "string", "minLength": 1 },
    "affectedGroups": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "claimState": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date" },
    "limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": true
}
